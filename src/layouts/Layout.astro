    </style>
   
   
  </head>
  <body>
    <header>
      <div class="logo">
        <a href="/">
          <img src="/logo.webp" alt="Power Grab TX" />
        </a>
        <h1 class="logo-title"><a href="/">Power Grab TX</a></h1>
      </div>
      <button class="hamburger" id="hamburger">☰</button>
      <nav id="nav">
        <a href="/">Home</a>
        <div class="nav-dropdown">
          <button type="button" class="dropdown-toggle">
            Trackers <span class="caret">▾</span>
          </button>
          <div class="dropdown-menu">
            <a href="/trackers/">All Trackers</a>
            <a href="/right-now/">Right Now</a>
          </div>
        </div>
        <div class="nav-dropdown">
          <button type="button" class="dropdown-toggle">
            Morning Briefing <span class="caret">▾</span>
          </button>
          <div class="dropdown-menu">
            {briefings.map((b) => (
              <a href={b.href}>{b.label}</a>
            ))}
