         inner pages as a shared header pattern. Grep before moving:
           grep -rln "class=\"page-header\"" src/pages
         ══════════════════════════════════════════════════════════════ */

      .page-header {
        text-align: center;
        padding: 3rem 2rem 2rem;
        max-width: 600px;
        margin: 0 auto;
      }
