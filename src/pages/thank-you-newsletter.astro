---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="You're Subscribed! | Power Grab TX"
  description="You're subscribed to the Power Grab TX Morning Briefing — plus your free download of the AI Data Center Glossary."
  noindex={true}
>
  <div class="thank-you-section">
    <img
      src="/powergrabtx.png"
      alt="Power Grab TX"
      class="thank-you-logo"
      width="630"
      height="630"
    />
    <h1>You're Subscribed!</h1>
    <p>
      Thanks for signing up for the Morning Briefing. Watch your inbox for
      the next one.
    </p>

    <div class="thank-you-download">
      <p class="thank-you-download-lead">Here's your free download:</p>
      <a
        href="/ai-data-center-glossary.pdf"
        class="btn"
        download
      >
        📄 Download the AI Data Center Glossary
      </a>
    </div>

    <a href="/" class="btn thank-you-home-btn">Back to Home</a>
  </div>
</Layout>
<style>
      .thank-you-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 4rem 1.5rem;
        max-width: 600px;
        margin: 0 auto;
      }

      .thank-you-logo {
        width: 180px;
        height: auto;
        margin-bottom: 1.5rem;
      }

      .thank-you-section h1 {
        font-size: 2rem;
        margin-bottom: 0.75rem;
      }

      .thank-you-section p {
        color: #555;
        margin-bottom: 2rem;
        line-height: 1.5;
      }

      .thank-you-download {
        background: #fff8f4;
        border: 1px solid #e8c9b0;
        border-radius: 10px;
        padding: 1.3rem 1.5rem;
        margin-bottom: 1.5rem;
      }
      .thank-you-download-lead {
        font-weight: 700;
        color: #3a2010;
        margin-bottom: 1rem;
      }
      .thank-you-home-btn {
        background: transparent;
        color: #1a4a8a;
        border: 2px solid #1a4a8a;
      }
      .thank-you-home-btn:hover {
        background: #f4f8fc;
      }

</style>
