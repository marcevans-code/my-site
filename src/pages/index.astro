---
import Layout from "../layouts/Layout.astro";

// ─────────────────────────────────────────────────────────────
// Pull today's (most recent) Morning Briefing straight from its
// source file so the homepage preview never goes stale — no manual
// daily edit needed here. Reads the title/description off the
// <Layout ...> tag and the first "Today's Signal" pull-quote.
// Uses a raw Vite glob import (bundle-safe) rather than Node's fs,
// since fs paths resolved from import.meta.url break once Astro
// bundles this frontmatter into dist/.
// ─────────────────────────────────────────────────────────────
const briefingSources = import.meta.glob("/src/pages/briefings/*.astro", {
  eager: true,
  query: "?raw",
  import: "default",
});
const briefingEntries = Object.entries(briefingSources)
  .map(([filePath, source]) => {
    const match = filePath.match(/morning-briefing-(\d{4}-\d{2}-\d{2})\.astro$/);
    return match ? { dateStr: match[1], source } : null;
  })
  .filter((b) => b !== null)
  .sort((a, b) => b.dateStr.localeCompare(a.dateStr));

let latestBriefing = null;
if (briefingEntries.length > 0) {
  const { dateStr, source } = briefingEntries[0];
  const descMatch = source.match(/description="([^"]+)"/);
  const signalMatch = source.match(/<strong>Today's Signal:<\/strong>\s*([^<]+)/);
  const [y, m, d] = dateStr.split("-").map(Number);

  latestBriefing = {
    href: `/briefings/morning-briefing-${dateStr}`,
    dateLabel: new Date(y, m - 1, d).toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    }),
    description: descMatch ? descMatch[1] : "",
    signal: signalMatch ? signalMatch[1].trim() : "",
  };
}
---

